#### 3.1 rebuild
srand(the.seed);
t = Tbl(csv())
#### 3.2 distance between two values, 0..1
c = t.cols.all[1]
c:dist(4, 4)
round(c:dist(4, 8))
#### 3.3 minkowski folds many column gaps into one
the.p
round(t:distx(t.rows[1], t.rows[1]))
round(t:distx(t.rows[1], t.rows[2]))
round(t:distx(t.rows[1], t.rows[398]))
#### 3.4 disty: distance to heaven, 0 = best on all goals
round(t:disty(t.rows[1]))
#### 3.5 sort every row by disty: the best cars surface
d = t:Y()
rows = keysort(t.rows, d)
round(d(rows[1]))
show(map(t.cols.y, function(c) return c.name end))
show(slice(rows[1], 6, 8))
round(d(rows[#rows]))
show(slice(rows[#rows], 6, 8))
