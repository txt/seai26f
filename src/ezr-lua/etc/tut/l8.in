#### 8.1 rebuild, cap the rows
srand(the.seed);
t = Tbl(csv())
t.rows = some(t.rows, the.cap)
#t.rows
#### 8.2 wins: turn disty into a 0..100 score vs the median
W = t:wins()
best = keysort(t.rows, t:Y())[1]
round(W(best))
#### 8.3 one holdout: train on half, rank the unseen half, pick top
b = t:holdout()
show{disty=round(t:disty(b)), win=round(W(b))}
#### 8.4 the honest comparison: 20 runs, active vs random
go = function(how, u) u = {}; for j=1,20 do srand(the.seed+j); u[1+#u]=W(t:holdout(how)) end; return sorted(u) end
L = go()
R = go(function(t2,cap) return slice(t2.rows, 1, cap) end)
#### 8.5 mean win: active acquire vs random labels
ml = round(sum(L, function(x) return x end)/20)
mr = round(sum(R, function(x) return x end)/20)
show{active=ml, random=mr}
#### 8.6 is the gap real, or noise? (Lecture 9 answers `same`)
same(L, R) and "tie" or (ml > mr and "active wins" or "random wins")
